{
  "icon": "resources/logo.png",
  "name": "go-to-code",
  "displayName": "go-to-code",
  "description": "Marca puntos importantes en el código y navega rápidamente entre ellos",
  "version": "0.1.0",
  "publisher": "GoToCode",
  "repository": {
    "type": "git",
    "url": "https://github.com/WilsonSolano/go-to-code.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Languages",
    "Visualization"
  ],
  "keywords": [
    "bookmark",
    "navigation",
    "quick-jump",
    "go-to-code"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "go-to-code.addPin",
        "title": "Go To Code: Agregar pin",
        "icon": "$(bookmark)"
      },
      {
        "command": "go-to-code.removePin",
        "title": "Go To Code: Eliminar pin",
        "icon": "$(close)"
      },
      {
        "command": "go-to-code.nextPin",
        "title": "Go To Code: Ir al siguiente pin"
      },
      {
        "command": "go-to-code.previousPin",
        "title": "Go To Code: Ir al pin anterior"
      },
      {
        "command": "go-to-code.showPinList",
        "title": "Go To Code: Mostrar lista de pins",
        "icon": "$(bookmark-fill)"
      },
      {
        "command": "go-to-code.clearAllPins",
        "title": "Go To Code: Eliminar todos los pins"
      },
      {
        "command": "go-to-code.editPinDescription",
        "title": "Go To Code: Editar descripción del pin"
      },
      {
        "command": "go-to-code.jumpToNearestPinAbove",
        "title": "Go To Code: Ir al pin más cercano arriba",
        "icon": "$(arrow-up)"
      },
      {
        "command": "go-to-code.showFilePins",
        "title": "Go To Code: Mostrar pines de este archivo",
        "icon": "$(menu)"
      }
    ],
    "keybindings": [
      {
        "command": "go-to-code.addPin",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      },
      {
        "command": "go-to-code.removePin",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      },
      {
        "command": "go-to-code.nextPin",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "go-to-code.previousPin",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "go-to-code-sidebar",
          "title": "Go To Code",
          "icon": "resources/pin.svg"
        }
      ]
    },
    "views": {
      "go-to-code-sidebar": [
        {
          "type": "tree",
          "id": "go-to-code.pinsView",
          "name": "Pines"
        }
      ],
      "panel": [
        {
          "type": "tree",
          "id": "go-to-code.pinsPanel",
          "name": "Go To Code"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "go-to-code.addPin",
          "group": "navigation",
          "when": "editorTextFocus"
        },
        {
          "command": "go-to-code.removePin",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "editor/title": [
        {
          "command": "go-to-code.jumpToNearestPinAbove",
          "group": "navigation@1",
          "when": "editorTextFocus"
        },
        {
          "command": "go-to-code.showFilePins",
          "group": "navigation@2",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "go-to-code.clearAllPins",
          "when": "view == go-to-code.pinsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "go-to-code.removePin",
          "when": "viewItem == pin",
          "group": "inline"
        },
        {
          "command": "go-to-code.editPinDescription",
          "when": "viewItem == pin"
        }
      ]
    },
    "colors": [
      {
        "id": "go-to-code.decorationColor",
        "description": "Color del marcador de pin",
        "defaults": {
          "dark": "#FFD700",
          "light": "#FFA500"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}