{
  "name": "go-to-code",
  "displayName": "go-to-code",
  "description": "Marca puntos importantes en el código y navega rápidamente entre ellos",
  "version": "0.1.0",
  "publisher": "go-to-code",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Languages",
    "Visualization"
  ],
  "keywords": [
    "bookmark",
    "navigation",
    "quick-jump",
    "pinpoint"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pinpoint.addPin",
        "title": "PinPoint: Agregar pin",
        "icon": "$(bookmark)"
      },
      {
        "command": "pinpoint.removePin",
        "title": "PinPoint: Eliminar pin",
        "icon": "$(close)"
      },
      {
        "command": "pinpoint.nextPin",
        "title": "PinPoint: Ir al siguiente pin"
      },
      {
        "command": "pinpoint.previousPin",
        "title": "PinPoint: Ir al pin anterior"
      },
      {
        "command": "pinpoint.showPinList",
        "title": "PinPoint: Mostrar lista de pins",
        "icon": "$(bookmark-fill)"
      },
      {
        "command": "pinpoint.clearAllPins",
        "title": "PinPoint: Eliminar todos los pins"
      }
    ],
    "keybindings": [
      {
        "command": "pinpoint.addPin",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      },
      {
        "command": "pinpoint.removePin",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      },
      {
        "command": "pinpoint.nextPin",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "pinpoint.previousPin",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pinpoint.addPin",
          "group": "navigation",
          "when": "editorTextFocus"
        },
        {
          "command": "pinpoint.removePin",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "editor/title": [
        {
          "command": "pinpoint.showPinList",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ]
    },
    "colors": [
      {
        "id": "pinpoint.decorationColor",
        "description": "Color del marcador de pin",
        "defaults": {
          "dark": "#FFD700",
          "light": "#FFA500"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}